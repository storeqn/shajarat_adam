/**
 * Shajarat Adam v3 — replace the existing Apps Script source and deploy a NEW VERSION
 * of the SAME web-app deployment (execute as owner, access Anyone).
 * No login/password, per owner request. Keep Orders/Backups/Audit sheets private.
 * First run setup() in the editor to authorize Sheets and Drive.
 */
var SPREADSHEET_ID='10oltsuuqDYiIXNPSiUMEgdXuJ2CF_eWQN9ZK3hdDt30';
var PRODUCT_HEADERS=['id','name','price','category','description','image','badge','active','old_price','offer','weight'];
var ORDER_STATUSES=['بانتظار تأكيد المتجر','مقبول','قيد التجهيز','جاهز','مكتمل','ملغي'];
function book_(){return SpreadsheetApp.openById(SPREADSHEET_ID)}
function sheet_(name,headers){var s=book_().getSheetByName(name);if(!s){s=book_().insertSheet(name);s.appendRow(headers)}return s}
function setup(){sheet_('المنتجات',PRODUCT_HEADERS);sheet_('الطلبات',['id','createdAt','status','json']);sheet_('سجل التعديلات',['at','action','detail']);sheet_('النسخ الاحتياطية',['at','fileId','name']);sheet_('الإحصاءات',['day','productId','name','views','intents']);folder_();return 'Ready: deploy a new version of the existing web app.'}
function folder_(){var props=PropertiesService.getScriptProperties(),id=props.getProperty('ADAM_IMAGES_FOLDER');if(id)return DriveApp.getFolderById(id);var f=DriveApp.createFolder('Shajarat Adam uploads');props.setProperty('ADAM_IMAGES_FOLDER',f.getId());return f}
function text_(v,max){return String(v==null?'':v).slice(0,max||2000)}
function cell_(v){return typeof v==='string'&&/^[=+@\-]/.test(v)?"'"+v:v}
function readProducts_(){var s=sheet_('المنتجات',PRODUCT_HEADERS);if(s.getLastRow()<2)return [];return s.getRange(2,1,s.getLastRow()-1,11).getValues().filter(function(r){return r[1]!==''}).map(function(r){var p={};PRODUCT_HEADERS.forEach(function(k,i){p[k]=r[i]});return p})}
function writeProducts_(items){var s=sheet_('المنتجات',PRODUCT_HEADERS),rows=items.map(function(p){return PRODUCT_HEADERS.map(function(k){return cell_(p[k]==null?'':p[k])})}),old=s.getLastRow();if(rows.length)s.getRange(2,1,rows.length,11).setValues(rows);if(old>rows.length+1)s.getRange(rows.length+2,1,old-rows.length-1,11).clearContent();SpreadsheetApp.flush()}
function meta_(p){try{var m=String(p.description||'').match(/\[adam-v3:([A-Za-z0-9+/=]+)\]$/);return m?JSON.parse(Utilities.newBlob(Utilities.base64Decode(m[1])).getDataAsString()):{}}catch(e){return {}}}
function pack_(p,meta){return String(p.description||'').replace(/\n?\[adam-v3:[A-Za-z0-9+/=]+\]$/,'')+'\n[adam-v3:'+Utilities.base64Encode(Utilities.newBlob(JSON.stringify(meta)).getBytes())+']'}
function validProduct_(p){if(!p||!String(p.name||'').trim()||!String(p.category||'').trim())throw Error('اسم المنتج والقسم مطلوبان');var price=Number(p.price);if(!Number.isSafeInteger(price)||price<0||price>100000000)throw Error('السعر غير صالح');if(p.image&&!/^https:\/\//i.test(p.image)&&!/^assets\/images\//.test(p.image))throw Error('رابط الصورة غير صالح');return {id:p.id==null?null:Number(p.id),name:text_(p.name,120),price:price,category:text_(p.category,120),description:text_(p.description,30000),image:text_(p.image,2000),badge:text_(p.badge,120),active:p.active!==false,old_price:Math.max(0,Number(p.old_price)||0),offer:!!p.offer,weight:text_(p.weight,80)}}
function audit_(action,detail){sheet_('سجل التعديلات',['at','action','detail']).appendRow([new Date().toISOString(),action,cell_(text_(detail,1000))])}
function backup_(items,reason){var props=PropertiesService.getScriptProperties(),id=props.getProperty('ADAM_BACKUP_FOLDER'),folder=id?DriveApp.getFolderById(id):DriveApp.createFolder('Shajarat Adam private backups');if(!id)props.setProperty('ADAM_BACKUP_FOLDER',folder.getId());var at=new Date().toISOString(),file=folder.createFile('adam-'+Date.now()+'.json',JSON.stringify({at:at,reason:reason,items:items}),MimeType.PLAIN_TEXT),s=sheet_('النسخ الاحتياطية',['at','fileId','name']);s.appendRow([at,file.getId(),reason]);if(s.getLastRow()>31){var stale=s.getRange(2,2,s.getLastRow()-31,1).getValues();stale.forEach(function(r){try{DriveApp.getFileById(r[0]).setTrashed(true)}catch(e){}});s.deleteRows(2,s.getLastRow()-31)}return file.getId()}
function readOrderRows_(){var s=sheet_('الطلبات',['id','createdAt','status','json']);return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,4).getValues()}
function listOrders_(){return readOrderRows_().slice(-500).reverse().map(function(r){var o=JSON.parse(r[3]);o.status=r[2];return o})}
function settings_(items){var p=items.filter(function(p){return p.category==='__settings__'})[0];return p?meta_(p).settings||{}:{}}
function createOrder_(raw){
 if(!raw||!/^AD-[A-Z0-9-]+$/.test(raw.id)||!/^07\d{9}$/.test(raw.phone)||!String(raw.name||'').trim())throw Error('بيانات الطلب غير صالحة');
 var existing=readOrderRows_().filter(function(r){return r[0]===raw.id});if(existing.length)return {id:raw.id};
 var products=readProducts_(),config=settings_(products),map={};products.forEach(function(p){map[p.id]=p});if(config.acceptOrders===false)throw Error('استقبال الطلبات متوقف');
 if(!Array.isArray(raw.items)||!raw.items.length||raw.items.length>100)throw Error('السلة غير صالحة');
 var total=0;raw.items=raw.items.map(function(line){var p=map[line.id],m=p?meta_(p):{};if(!p||p.active===false||String(p.active).toLowerCase()==='false'||m.deleted||m.available===false||p.category==='__settings__'||p.category==='سلايدر العروض')throw Error('منتج غير متوفر');var qty=Number(line.qty),price=Number(line.price);if(!Number.isInteger(qty)||qty<1||qty>99||!Number.isSafeInteger(price)||price<Number(p.price))throw Error('كمية أو سعر غير صالح');var allowed=[Number(p.price)],flavors=[{price:0}].concat(m.flavors||[]),packaging=[{price:0}].concat(m.packaging||[]);flavors.forEach(function(f){packaging.forEach(function(g){allowed.push(Number(p.price)+Number(f.price)+Number(g.price))})});if(allowed.indexOf(price)<0)throw Error('السعر تغيّر؛ حدّث المنيو');total+=price*qty;return {id:p.id,name:p.name,weight:p.weight,qty:qty,price:price,custom:text_(line.custom,500)}});
 if(raw.mode!=='collect'&&raw.mode!=='delivery')throw Error('طريقة استلام غير صالحة');if(raw.mode==='delivery'&&!String(raw.address||'').trim()&&!/^https:\/\/www.google.com\/maps\?q=/.test(raw.location||''))throw Error('عنوان التوصيل مطلوب');
 var date=new Date(String(raw.requestedAt)+'+03:00');if(!Number.isFinite(date.getTime())||date.getTime()<Date.now()+Math.max(0,Number(config.leadMinutes)||0)*60000-60000||date.getTime()>Date.now()+(Number(config.maxAdvanceDays)||30)*86400000)throw Error('موعد غير صالح');
 if(config.hoursEnabled){var t=Utilities.formatDate(date,'Asia/Baghdad','HH:mm'),open=config.open,close=config.close;if(!(open<=close?t>=open&&t<close:t>=open||t<close))throw Error('الموعد خارج ساعات العمل')}
 var fee=0;if(raw.mode==='delivery'&&raw.zone){var zone=(config.zones||[]).filter(function(z){return z.name===raw.zone})[0];if(!zone)throw Error('منطقة التوصيل غير صالحة');fee=Number(zone.fee)||0}
 var order={id:raw.id,createdAt:new Date().toISOString(),status:ORDER_STATUSES[0],name:text_(raw.name,120),phone:raw.phone,address:text_(raw.address,1000),location:text_(raw.location,250),mode:raw.mode,note:text_(raw.note,1000),requestedAt:raw.requestedAt,zone:text_(raw.zone,120),fee:fee,total:total+fee,items:raw.items};
 sheet_('الطلبات',['id','createdAt','status','json']).appendRow([order.id,order.createdAt,order.status,JSON.stringify(order)]);audit_('طلب جديد',order.id);return {id:order.id,total:order.total}
}
function dispatch_(action,args){
 var all=readProducts_();
 if(action==='saveProduct'){var p=validProduct_(args[0]),id=p.id;if(id==null)id=all.reduce(function(max,p){return Math.max(max,Number(p.id)||0)},0)+1;p.id=id;var index=all.findIndex(function(x){return Number(x.id)===id});backup_(all,'قبل حفظ منتج');if(index<0)all.push(p);else all[index]=p;writeProducts_(all);audit_('حفظ منتج',p.name);return {refreshProducts:true}}
 if(action==='saveGroup'){
  var payload=args[0];if(!payload||!Array.isArray(payload.products)||!Array.isArray(payload.originalIds))throw Error('مجموعة غير صالحة');
  if(payload.original){payload.original.forEach(function(p){var current=all.filter(function(x){return Number(x.id)===Number(p.id)})[0];if(!current||PRODUCT_HEADERS.some(function(k){return String(current[k]??'')!==String(p[k]??'')}))throw Error('تغيّرت البيانات في جهاز آخر؛ حدّث القائمة قبل الحفظ')})}
  var nextId=all.reduce(function(max,p){return Math.max(max,Number(p.id)||0)},0)+1,seen={},incoming=payload.products.map(function(raw){var p=validProduct_(raw);if(p.id==null)p.id=nextId++;if(!Number.isSafeInteger(p.id)||p.id<0||seen[p.id])throw Error('معرّف مكرر أو غير صالح');seen[p.id]=true;if(all.some(function(x){return Number(x.id)===p.id})&&payload.originalIds.indexOf(p.id)<0)throw Error('معرّف ينتمي لمنتج آخر');return p});
  var deleted=payload.originalIds.filter(function(id){return !seen[id]});
  var updated=all.map(function(p){if(deleted.indexOf(Number(p.id))>=0){var m=meta_(p);m.deleted=true;m.wasActive=p.active;m.deletedAt=new Date().toISOString();p.description=pack_(p,m);p.active=false}return p}).filter(function(p){return !seen[Number(p.id)]}).concat(incoming);
  backup_(all,'قبل حفظ مجموعة');try{writeProducts_(updated)}catch(e){writeProducts_(all);throw e}audit_('حفظ مجموعة',incoming.length+' خيار');return {refreshProducts:true};
 }
 if(action==='uploadImage'){var image=args[0],match=String(image.data||'').match(/^data:image\/(jpeg|png|webp);base64,([A-Za-z0-9+/=]+)$/);if(!match||image.data.length>1000000)throw Error('الصورة غير صالحة أو كبيرة');var blob=Utilities.newBlob(Utilities.base64Decode(match[2]),'image/'+match[1],Utilities.getUuid()+'.'+match[1]),file=folder_().createFile(blob);file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);audit_('رفع صورة',text_(image.name));return {url:'https://lh3.googleusercontent.com/d/'+file.getId()+'=w1000'}}
 if(action==='trackEvents'){var events=args[0];if(!Array.isArray(events)||events.length>100)throw Error('إحصاءات غير صالحة');var day=Utilities.formatDate(new Date(),'Asia/Baghdad','yyyy-MM-dd'),rows=[];events.forEach(function(e){var p=all.filter(function(p){return Number(p.id)===Number(e.id)})[0],count=Number(e.count);if(!p||['views','intents'].indexOf(e.kind)<0||!Number.isInteger(count)||count<1||count>99)return;var m=meta_(p);rows.push([day,m.productId||String(p.id),cell_(p.name),e.kind==='views'?count:0,e.kind==='intents'?count:0])});if(rows.length){var s=sheet_('الإحصاءات',['day','productId','name','views','intents']);s.getRange(s.getLastRow()+1,1,rows.length,5).setValues(rows)}return {ok:true}}
 if(action==='createOrder')return createOrder_(args[0]);
 if(action==='updateOrder'){var request=args[0];if(ORDER_STATUSES.indexOf(request.status)<0)throw Error('حالة غير صالحة');var rows=readOrderRows_(),i=rows.findIndex(function(r){return r[0]===request.id});if(i<0)throw Error('الطلب غير موجود');sheet_('الطلبات',['id','createdAt','status','json']).getRange(i+2,3).setValue(request.status);audit_('حالة طلب',request.id+' '+request.status);return {ok:true}}
 if(action==='deleteProduct')throw Error('استخدم سلة المحذوفات بدلاً من الحذف النهائي');
 throw Error('العملية غير مدعومة')
}
function reply_(data,callback){var json=JSON.stringify(data);if(callback){if(!/^[A-Za-z_$][\w$]{0,100}$/.test(callback))throw Error('Invalid callback');return ContentService.createTextOutput(callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){var p=e.parameter||{};try{
 if(p.action==='capabilities')return reply_({version:3,uploads:true,orders:true,atomicGroups:true},p.callback);
 if(p.action==='status'){var status=CacheService.getScriptCache().get('status:'+p.requestId);return reply_(status?JSON.parse(status):{pending:true},p.callback)}
 if(p.action==='products')return reply_({products:readProducts_().filter(function(p){var m=meta_(p);return p.active!==false&&String(p.active).toLowerCase()!=='false'&&!m.deleted})},p.callback);
 if(p.action==='listProducts')return reply_({ok:true,result:readProducts_()},p.callback);
 if(p.action==='listOrders')return reply_({ok:true,result:listOrders_()},p.callback);
 if(p.action==='stats'){var s=sheet_('الإحصاءات',['day','productId','name','views','intents']),rows=s.getLastRow()<2?[]:s.getRange(Math.max(2,s.getLastRow()-19999),1,Math.min(20000,s.getLastRow()-1),5).getValues(),counts={},since=Utilities.formatDate(new Date(Date.now()-30*86400000),'Asia/Baghdad','yyyy-MM-dd');rows.forEach(function(r){var day=r[0] instanceof Date?Utilities.formatDate(r[0],'Asia/Baghdad','yyyy-MM-dd'):String(r[0]);if(day<since)return;var k=String(r[1]);if(!counts[k])counts[k]={name:r[2],views:0,intents:0};counts[k].views+=Number(r[3])||0;counts[k].intents+=Number(r[4])||0});return reply_({ok:true,result:Object.keys(counts).map(function(k){return counts[k]}).sort(function(a,b){return b.views-a.views}).slice(0,20)},p.callback)}
 if(p.action==='audit'){var s=sheet_('سجل التعديلات',['at','action','detail']);return reply_({ok:true,result:s.getLastRow()<2?[]:s.getRange(Math.max(2,s.getLastRow()-99),1,Math.min(100,s.getLastRow()-1),3).getValues().reverse().map(function(r){return {at:r[0],action:r[1],name:r[2],actor:'إدارة المتجر'}})},p.callback)}
 if(p.action==='backups'){var b=sheet_('النسخ الاحتياطية',['at','fileId','name']);return reply_({ok:true,result:b.getLastRow()<2?[]:b.getRange(2,1,b.getLastRow()-1,3).getValues().reverse().map(function(r){return {at:r[0],fileId:r[1],reason:r[2]}})},p.callback)}
 if(p.action==='backup'){var rows=sheet_('النسخ الاحتياطية',['at','fileId','name']).getDataRange().getValues();if(!rows.some(function(r){return r[1]===p.fileId}))throw Error('النسخة غير موجودة');return reply_({ok:true,result:JSON.parse(DriveApp.getFileById(p.fileId).getBlob().getDataAsString())},p.callback)}
 return reply_({ok:false,error:'العملية غير مدعومة'},p.callback)
 }catch(error){return reply_({ok:false,error:error.message},p.callback)}}
function doPost(e){var request,lock=LockService.getScriptLock();try{request=JSON.parse(e.postData.contents);if(!/^[\w-]{10,80}$/.test(request.requestId||''))throw Error('معرّف طلب غير صالح');lock.waitLock(30000);var cache=CacheService.getScriptCache(),key='status:'+request.requestId;if(cache.get(key))return reply_({ok:true});var result=dispatch_(request.action,request.args||[]);cache.put(key,JSON.stringify({ok:true,result:result}),3600);return reply_({ok:true})}catch(error){if(request&&request.requestId)CacheService.getScriptCache().put('status:'+request.requestId,JSON.stringify({ok:false,error:error.message}),3600);return reply_({ok:false,error:error.message})}finally{if(lock.hasLock())lock.releaseLock()}}
